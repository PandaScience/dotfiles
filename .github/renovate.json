{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "14 days",
  "packageRules": [
    {
      "description": "One MR for minor and patch mise bumps",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      // Grouped MR titles use groupName, not commitMessageTopic.
      "groupName": "minor mise tool versions",
      "commitMessageTopic": "minor mise tool versions",
      // Schedule is managed by the GitHub Actions workflow cron
      // "schedule": ["every friday"],
      "automerge": true,
      "commitMessagePrefix": "tools:",
      "commitMessageAction": "bump",
      "commitMessageExtra": "",
      // mise reports versions without the "v" prefix but upstream GitHub releases
      // use "vX.Y.Z" tags, so Renovate cannot resolve the commit SHA for digests.
      "pinDigests": false
    },
    {
      "description": "One MR per major mise bump, title includes the tool name",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "commitMessagePrefix": "tools:",
      "commitMessageAction": "bump",
      "commitMessageExtra": "(major)",
      "pinDigests": false
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "automerge": false,
      "commitMessagePrefix": "ci:",
      "commitMessageAction": "bump",
      "commitMessageTopic": "github action versions",
      "commitMessageExtra": "",
      "pinDigests": true
    }
  ]
}
