{
  "meta": {
    "name": "claude-custom",
    "description": "Claude profile with access to certain bin and config paths like mise etc."
  },
  "workdir": {
    "access": "readwrite"
  },
  "security": {
    "groups": ["git_config"]
  },
  "filesystem": {
    "allow": [
      "$WORKDIR",
      "~/Claude",
      "~/.cache/go-build/",
      "/tmp/",
      "/tmp/claude-1000/"
    ],
    "read": ["~/.gitconfig.d/", "~/.local/share/mise/installs/", "~/.config/gh"]
  },
  "network": {
    "block": false
  }
}
