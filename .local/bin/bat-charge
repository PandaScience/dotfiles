#!/usr/bin/env bash
# Set BAT0 charge start/end thresholds (ThinkPad sysfs).
set -euo pipefail

B=/sys/class/power_supply/BAT0
S=$B/charge_control_start_threshold
E=$B/charge_control_end_threshold

[[ -f $S && -f $E ]] || { echo "error: thresholds not supported on $B" >&2; exit 1; }

if [[ $# -eq 0 ]]; then
  echo "start=$(<$S) end=$(<$E) capacity=$(<$B/capacity)% status=$(<$B/status)"
  exit 0
fi

[[ $# -eq 2 && $1 -ge 0 && $1 -lt $2 && $2 -le 100 ]] || {
  echo "usage: bat-charge <start> <end>   # e.g. bat-charge 75 80" >&2
  exit 1
}

set_one() { printf '%s\n' "$2" | sudo tee "$1" >/dev/null; }

cur_e=$(<$E)
# Never leave start >= end even briefly: raise end first, else lower start first.
if (( $2 > cur_e || $1 >= cur_e )); then
  set_one "$E" "$2"
  set_one "$S" "$1"
else
  set_one "$S" "$1"
  set_one "$E" "$2"
fi

echo "start=$(<$S) end=$(<$E)"
